# Distribution:
distribution test

# Server:
server-version SERVER_VERSION
shard-low-pop 35
shard-mid-pop 75
access-level-clamp 150 700

# Core features:
want-pets #f
want-parties #f
want-achievements #f
want-true-friends #t

# Chat:
want-whitelist #t

# Sellbot boss:
disable-sos-card 91917
disable-sos-card 91918

# Holidays:
active-holidays 97, 98, 99, 26, 3
base-xp-multiplier 1.0

# Events:
want-storm-event #f

# Developer options:
show-population #t
force-skip-tutorial #f
want-instant-parties #t
