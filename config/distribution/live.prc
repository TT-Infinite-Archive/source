# Distribution:
distribution live

# Server:
server-version SERVER_VERSION
shard-low-pop 100
shard-mid-pop 150
client-agents 8

# Temporary configuration for SP Alpha
# until we get our web account API up and running.
force-access-level 100

# Core features:
want-kaldron-network #f
want-multiplayer #f
want-grouptracker #f
want-game-tables #f
want-true-friends #f
want-achievements #f
want-parties #f
force-skip-tutorial #t

# Safe zones:
want-safe-zones #t
want-toontown-central #t
want-donalds-dock #f
want-daisys-garden #f
want-minnies-melodyland #f
want-the-burrrgh #f
want-donalds-dreamland #f
want-goofy-speedway #f
want-outdoor-zone #f
want-golf-zone #f
want-resistance-grounds #f

# Chat:
want-whitelist #t
want-blacklist #t

# Sellbot boss:
disable-sos-card 91917
disable-sos-card 91918

# Holidays:
base-xp-multiplier 1.0

# Optional
want-phone-quest #f
want-yin-yang #f
want-heartbeat #f

# Developer options:
show-population #f

# Debug tools:
want-leak-graph-ai #f
want-leak-graph-client #f

# Unlock timer:
want-unlock-timer #t
unlock-time Sun Dec 6 19:20:00 2015
unlock-text Toontown Infinite will open in:
