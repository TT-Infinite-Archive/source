# Distribution:
distribution live

# Server:
server-version SERVER_VERSION
shard-low-pop 100
shard-mid-pop 150
client-agents 8

# Core features:
want-grouptracker #t
want-game-tables #t
want-true-friends #f
want-achievements #f
want-parties #f
force-skip-tutorial #t

# Safezones:
want-goofy-speedway #f

# Chat:
want-whitelist #t
want-blacklist #t

# Sellbot boss:
disable-sos-card 91917
disable-sos-card 91918

# Holidays:
base-xp-multiplier 1.0

# Optional
want-phone-quest #f
want-yin-yang #f
want-heartbeat #f

# Developer options:
show-population #f

# Debug tools:
want-leak-graph-ai #f
want-leak-graph-client #f

# Unlock timer:
want-unlock-timer #t
unlock-time Sun Dec 6 19:20:00 2015
unlock-text Toontown Infinite will open in:

# Toon patches:
toon-patch-version 1

