# Distribution:
distribution live

# UberDOG:
generate-root-object #t

# Live account & gateway services:
want-game-gateway #t
account-service-url https://infinite.toontown.io

# The website owns accounts here with the launcher's lauch token being the credential:
accountdb-type production

# gateway-url is derived from account-service-url

# Magic words:
want-cheats #t
magic-word-minimum-access 200
magic-word-live-access #t
